Screen {
	background: $background;
	color: $text;
}

#root {
	width: 100%;
	height: 100%;
}

#content {
	width: 100%;
	height: 1fr;
	padding: 0 2;
}

#header {
	width: 100%;
	margin-bottom: 1;
}

#title {
	color: $text;
	text-style: bold;
	width: 1fr;
}

#status {
	color: $accent;
	border: round $accent;
	padding: 0 2;
	text-style: bold;
	width: auto;
}

#status.paused {
	color: $muted;
	border: round $muted;
}

#clock-block {
	width: 100%;
	margin-bottom: 1;
}

#clock {
	text-align: center;
	color: $text;
	text-style: bold;
}

#date-block {
	width: 100%;
	margin-bottom: 1;
}

#date {
	color: $accent;
	text-align: center;
}

#timezone {
	color: $muted;
	text-align: center;
}

#cards {
	width: 100%;
	margin-bottom: 1;
}

.panel {
	width: 1fr;
	border: round $surface_border;
	padding: 1 2;
	margin-right: 2;
}

#cards > .panel:last-child {
	margin-right: 0;
}

.section-title {
	color: $muted;
}

.card-value {
	color: $text;
	text-style: bold;
	margin: 1 0;
}

.card-subtitle {
	color: $secondary;
}

#progress-block {
	width: 100%;
}

#progress-meta {
	width: 100%;
}

#progress-remaining {
	color: $muted;
	width: 1fr;
}

#next-time {
	color: $text;
}

#countdown {
	color: $accent;
}

#progress-percent {
	color: $text;
	text-style: bold;
	width: 1fr;
	text-align: right;
}

#progress-bar {
	width: 100%;
	height: 2;
	margin-bottom: 1;
}

#announcements-block {
	width: 100%;
	border-top: solid $surface_border;
	margin-bottom: 1;
}

#announcements-title {
	color: $muted;
}

#announcements {
	color: $accent;
}

#footer {
	dock: bottom;
	width: 100%;
	text-align: center;
	color: $muted;
	padding: 0 2;
}


Screen {
	background: #0b100e;
	color: #eef5f1;
}

#root {
	width: 100%;
	height: 100%;
}

#content {
	width: 100%;
	height: 1fr;
	padding: 0 2;
}

#header {
	width: 100%;
	margin-bottom: 1;
}

#title {
	color: #eef5f1;
	text-style: bold;
	width: 1fr;
}

#status {
	color: #8fe3c4;
	border: round #8fe3c4;
	padding: 0 2;
	text-style: bold;
	width: auto;
}

#status.paused {
	color: #7f8f87;
	border: round #7f8f87;
}

#clock-block {
	width: 100%;
	margin-bottom: 1;
}

#clock {
	text-align: center;
	color: #ffffff;
	text-style: bold;
}

#date-block {
	width: 100%;
	margin-bottom: 1;
}

#date {
	color: #a9b8b0;
	text-align: center;
}

#timezone {
	color: #7f8f87;
	text-align: center;
}

#cards {
	width: 100%;
	margin-bottom: 1;
}

.panel {
	width: 1fr;
	border: round #22302a;
	padding: 1 2;
	margin-right: 2;
}

#cards > .panel:last-child {
	margin-right: 0;
}

.section-title {
	color: #7f8f87;
}

.card-value {
	color: #eef5f1;
	text-style: bold;
	margin: 1 0;
}

.card-subtitle {
	color: #a9b8b0;
}

#progress-block {
	width: 100%;
}

#progress-meta {
	width: 100%;
}

#progress-remaining {
	color: #dfe9e3;
	width: 1fr;
}

#progress-percent {
	color: #ffffff;
	text-style: bold;
	width: 1fr;
	text-align: right;
}

#progress-bar {
	width: 100%;
	height: 2;
	margin-bottom: 1;
}

#announcements-block {
	width: 100%;
	border-top: solid #22302a;
	margin-bottom: 1;
}

#announcements-title {
	color: #7f8f87;
}

#announcements {
	color: #a9b8b0;
}

#footer {
	dock: bottom;
	width: 100%;
	text-align: center;
	color: #7f8f87;
	padding: 0 2;
}
